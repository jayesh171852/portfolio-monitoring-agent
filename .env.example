# AI Reasoning Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Groq (Optional alternative)
GROQ_API_KEY=your_groq_api_key_here

# Supabase (Optional - in-memory fallback included)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Data Provider API Keys (Optional - built-in simulation and fallbacks available)
TAVILY_API_KEY=your_tavily_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
MARKET_DATA_API_KEY=your_market_data_key_here
NEWS_API_KEY=your_news_api_key_here

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
